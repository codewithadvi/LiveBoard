{
  "name": "liveboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "node node_modules/tsx/dist/cli.mjs server/src/index.ts",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "tsx --test --test-concurrency=1 shared/test/*.test.ts server/test/*.test.ts client/test/*.test.ts",
    "loadtest": "node node_modules/tsx/dist/cli.mjs scripts/loadtest.ts"
  }
}
